# AI 服务配置模板
# 复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 忽略，不会提交）
# 变量名采用 OpenAI 生态标准名，可对接任意 OpenAI 兼容服务商
OPENAI_API_KEY=sk-你的密钥
# 接口地址：默认 DeepSeek；切换其他服务商改这里（如 https://api.openai.com/v1/chat/completions）
OPENAI_BASE_URL=https://api.deepseek.com/v1/chat/completions
# 模型名：V4 系列为 deepseek-v4-flash / deepseek-v4-pro；
# 旧版 deepseek-chat / deepseek-reasoner 将于 2026-07-24 下线
OPENAI_MODEL=deepseek-v4-flash
# AI 系统提示词：定义 AI 角色与回答风格（后端统一注入，改文案无需改代码）
AI_SYSTEM_PROMPT=你是AI助手，请用友好、简洁的中文回答用户问题。

# 数据库连接（敏感项：密码请勿提交到 git）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=news_app

# Redis 连接（敏感项：密码请勿提交到 git）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=你的Redis密码
REDIS_DB=0
